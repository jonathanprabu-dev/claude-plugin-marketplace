#!/usr/bin/env sh
# Launcher for the logfire-docs skill. Claude Code puts each plugin's bin/
# directory on PATH, so the skill can call `logfire-docs` from any cwd
# instead of needing to know where the plugin is installed.
DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec python "$DIR/skills/logfire-docs/scripts/docs.py" "$@"
