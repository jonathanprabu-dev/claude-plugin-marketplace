#!/usr/bin/env sh
# Launcher for the claude-code-docs skill. Claude Code puts each plugin's bin/
# directory on PATH, so the skill can call `claude-code-docs` from any cwd
# instead of needing to know where the plugin is installed.
DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec python "$DIR/skills/claude-code-docs/scripts/docs.py" "$@"
